// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Users (Admins and Customers)
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Hashed password
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  orders    Order[]
}

// 2. The Artworks
model Product {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Decimal
  images      String[] // Array of image URLs
  category    Category
  stock       Int      @default(1)
  featured    Boolean  @default(false) // For the Homepage slider
  createdAt   DateTime @default(now())
  orderItems  OrderItem[]
}

// 3. Orders
model Order {
  id         String      @id @default(uuid())
  userId     String?     // Nullable for Guest Checkout (Optional V2)
  user       User?       @relation(fields: [userId], references: [id])
  items      OrderItem[]
  total      Decimal
  status     OrderStatus @default(PENDING)
  createdAt  DateTime    @default(now())
}

// 4. Link table to preserve price at time of purchase
model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal // Price at the moment of purchase
}

enum Role {
  USER
  ADMIN
}

enum Category {
  ORIGINAL
  PRINT
  DIGITAL
  MERCH
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
}
